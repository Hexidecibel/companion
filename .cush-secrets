schema = 1

# Secrets manifest for the Companion daemon. Refs are pointers, not values —
# safe to commit. Materialize with `bin/companion install-secrets` (writes a
# chmod-600 env file to ~/.companion/herald.env, outside the repo) or
# `eval "$(/home/hexi/local/src/cush-tools/bin/inject --env --no-prompt)"`.

[defaults]
target_vault = "cush"
target_item = "{project}"
field_template = "{key}"

[secrets]
# Herald brain (anthropic provider). Read from the daemon's environment only;
# never written to config.json.
ANTHROPIC_API_KEY = { ref = "inf://prod/companion/ANTHROPIC_API_KEY", target_vault = "cush", target_item = "companion" }
