#!/bin/bash
# herald-sandbox — run THIS checkout's daemon as an isolated test instance with
# the Herald brain on the anthropic provider, without touching production.
#
# Usage:
#   bin/herald-sandbox [--instance NAME] start|stop|status|logs|env
#   bin/herald-sandbox start     Build-check, write sandbox config, launch in background
#   bin/herald-sandbox stop      Stop the sandbox daemon (SIGTERM, then SIGKILL) and verify the port is free
#   bin/herald-sandbox status    PID, port owner, and whether Herald's brain is configured
#   bin/herald-sandbox logs [N]  Tail the sandbox daemon log (key-shaped strings redacted)
#   bin/herald-sandbox env       Print the sandbox URL/port and config path (token not printed)
#   bin/herald-sandbox https [on|off|status] [--tunnel]
#                                HTTPS front door for the sandbox (browsers only expose the
#                                microphone in secure contexts). Default: Tailscale serve on
#                                https://<this-node>.ts.net:$HERALD_HTTPS_PORT (9890, tailnet only,
#                                real cert). --tunnel: cush-tools tunnel instead
#                                (https://herald-voice.tunnel.cush.rocks, expires after 1h;
#                                extend with cush-tools bin/status extend herald-voice).
#
# Instances: the default instance (port 9887) is the one the user talks to; its
# conversation is live history. Automated probing uses a SEPARATE instance:
#   bin/herald-sandbox --instance probe start   # port 9888, own HOME/config/state
#   node daemon/scripts/herald-probe.js "question" ...   # defaults to the probe instance
#   bin/herald-sandbox --instance probe stop    # verifies the port is free
# A non-default instance gets its own dir ($SANDBOX_DIR-<name>) and starts with a
# fresh Herald conversation every time (its state.json is cleared on start).
# Port: HERALD_SANDBOX_PORT, else 9888 for "probe"; other instances must set it.
#
# Isolation guarantees:
#   - Own port (HERALD_SANDBOX_PORT, default 9887) and a single listener, so it
#     never collides with production's 9877/9878. mDNS off. No remote
#     capabilities (exec / dispatch / write) on the sandbox listener.
#   - Own HOME ($SANDBOX_DIR/home): the daemon writes its PID file, audit log,
#     notification/push state, session names etc. under $HOME/.companion. Without
#     this, the sandbox would overwrite (and on exit delete) production's
#     ~/.companion/daemon.pid and share its push-token store.
#   - Own Herald state dir via COMPANION_HERALD_STATE_DIR (never
#     ~/.companion/herald/state.json).
#   - COMPANION_SANDBOX=1 (implies COMPANION_READONLY_SHARED_STATE=1): the daemon
#     never writes the shared ~/.claude/companion-session-mappings.json /
#     companion-sessions-snapshot.json, never registers push devices or sends
#     pushes (no duplicate notifications on the phone), and never auto-approves
#     tools (production already does).
#   - Same auth token as production's first listener, so an already-paired
#     browser/app can connect to the sandbox without a new token. Never printed.
#   - ANTHROPIC_API_KEY is resolved from Infisical with cush-tools inject --env
#     into THIS process's environment only: never written to disk, config, or logs.
#
# It still READS the real Claude sessions (code_home from the live config and the
# shared tmux server), which is the point. Never confirm a Herald action against
# the sandbox unless you mean to type into a real session.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
ENTRY="$ROOT/daemon/dist/index.js"
LIVE_CONFIG="${COMPANION_CONFIG:-$HOME/.companion/config.json}"

INSTANCE="default"
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --instance) INSTANCE="${2:-}"; shift 2 ;;
    --instance=*) INSTANCE="${1#--instance=}"; shift ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"
case "$INSTANCE" in
  ""|*[!a-z0-9-]*) echo "ERROR: --instance must be lowercase letters, digits or hyphens"; exit 2 ;;
esac

BASE_SANDBOX_DIR="${HERALD_SANDBOX_DIR:-$HOME/.cache/companion-herald-sandbox}"
if [ "$INSTANCE" = "default" ]; then
  SANDBOX_DIR="$BASE_SANDBOX_DIR"
  DEFAULT_PORT=9887
else
  SANDBOX_DIR="$BASE_SANDBOX_DIR-$INSTANCE"
  if [ "$INSTANCE" = "probe" ]; then DEFAULT_PORT=9888; else DEFAULT_PORT=""; fi
fi
SANDBOX_HOME="$SANDBOX_DIR/home"
SANDBOX_CONFIG="$SANDBOX_DIR/config.json"
STATE_DIR="$SANDBOX_DIR/herald"
LOG_FILE="$SANDBOX_DIR/daemon.log"
PID_FILE="$SANDBOX_DIR/sandbox.pid"
PORT="${HERALD_SANDBOX_PORT:-$DEFAULT_PORT}"
[ -n "$PORT" ] || { echo "ERROR: instance '$INSTANCE' needs HERALD_SANDBOX_PORT (a free 9400-9900 port)"; exit 2; }
if [ "$INSTANCE" != "default" ] && [ "$PORT" = "9887" ]; then
  echo "ERROR: port 9887 belongs to the default sandbox (the user's live Herald conversation)"; exit 2
fi
CUSH_INJECT="${CUSH_INJECT:-$HOME/local/src/cush-tools/bin/inject}"
MANIFEST="$ROOT/.cush-secrets"
PRODUCTION_PORTS="9877 9878"

redact() { sed -E 's/sk-ant-[A-Za-z0-9_-]+/[REDACTED]/g'; }

ensure_node() {
  if ! command -v node &>/dev/null && [ -s "$HOME/.nvm/nvm.sh" ]; then
    # shellcheck disable=SC1091
    . "$HOME/.nvm/nvm.sh" >/dev/null
  fi
  command -v node &>/dev/null || { echo "ERROR: node not found"; exit 1; }
}

running_pid() {
  [ -f "$PID_FILE" ] || return 1
  local pid
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
  # Guard against PID reuse: it must be our entry point.
  tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q "$ENTRY" || return 1
  echo "$pid"
}

port_owner() { ss -ltnpH "sport = :$1" 2>/dev/null | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2 || true; }

write_config() {
  [ -f "$LIVE_CONFIG" ] || { echo "ERROR: live config not found: $LIVE_CONFIG"; exit 1; }
  mkdir -p "$SANDBOX_HOME/.companion" "$STATE_DIR"
  chmod 700 "$SANDBOX_DIR" "$SANDBOX_HOME"
  # Read-only copies of naming metadata so Herald shows the same session names.
  # (Not work-groups.json: the sandbox must not monitor production's workers.)
  local f
  for f in session-names.json tmux-sessions.json; do
    [ -f "$HOME/.companion/$f" ] && cp "$HOME/.companion/$f" "$SANDBOX_HOME/.companion/$f"
  done
  LIVE="$LIVE_CONFIG" OUT="$SANDBOX_CONFIG" PORT="$PORT" STATE="$STATE_DIR" node -e '
    const fs = require("fs"), crypto = require("crypto");
    const live = JSON.parse(fs.readFileSync(process.env.LIVE, "utf-8"));
    // Reuse production auth token (first listener, else legacy root token) so the
    // same paired clients work; fall back to the previous sandbox token / random.
    let token = (Array.isArray(live.listeners) && live.listeners[0] && live.listeners[0].token) || live.token;
    if (!token) {
      try { token = JSON.parse(fs.readFileSync(process.env.OUT, "utf-8")).listeners[0].token; } catch {}
    }
    const cfg = { ...live };
    delete cfg.port; delete cfg.token; delete cfg.tls; delete cfg.remote_capabilities;
    cfg.listeners = [{ port: Number(process.env.PORT), token: token || crypto.randomBytes(24).toString("hex"), tls: false }];
    cfg.mdns_enabled = false;
    cfg.herald = { ...(live.herald || {}), provider: "anthropic", state_dir: process.env.STATE };
    fs.writeFileSync(process.env.OUT, JSON.stringify(cfg, null, 2) + "\n", { mode: 0o600 });
    fs.chmodSync(process.env.OUT, 0o600);
  '
}

cmd_start() {
  ensure_node
  if pid="$(running_pid)"; then
    echo "Sandbox ($INSTANCE) already running (PID $pid) on port $PORT"
    return 0
  fi
  local owner
  owner="$(port_owner "$PORT")"
  if [ -n "$owner" ]; then
    echo "ERROR: port $PORT is already in use (pid $owner). Set HERALD_SANDBOX_PORT to another free 9400-9900 port."
    exit 1
  fi
  case " $PRODUCTION_PORTS " in *" $PORT "*) echo "ERROR: refusing to use a production port ($PORT)"; exit 1 ;; esac
  [ -f "$ENTRY" ] || { echo "ERROR: $ENTRY missing. Build first: (cd $ROOT/daemon && npm run build)"; exit 1; }
  if find "$ROOT/daemon/src" -name '*.ts' -newer "$ENTRY" -print -quit | grep -q .; then
    echo "WARNING: daemon sources are newer than dist/; rebuild for current code: (cd $ROOT/daemon && npm run build)"
  fi
  [ -x "$CUSH_INJECT" ] || { echo "ERROR: cush-tools inject not found at $CUSH_INJECT"; exit 1; }

  write_config
  if [ "$INSTANCE" != "default" ]; then
    # Throwaway instances start every run with an empty conversation.
    rm -f "$STATE_DIR/state.json"
  fi

  # Resolve the key into this shell only (eval'd exports; nothing on disk).
  local exports
  if ! exports="$("$CUSH_INJECT" --manifest "$MANIFEST" --env --no-prompt 2>/dev/null)"; then
    echo "ERROR: could not resolve secrets from $MANIFEST (run: $CUSH_INJECT --manifest $MANIFEST --check)"
    exit 1
  fi
  eval "$exports"
  unset exports
  [ -n "${ANTHROPIC_API_KEY:-}" ] || { echo "ERROR: ANTHROPIC_API_KEY did not resolve"; exit 1; }

  : > "$LOG_FILE"
  chmod 600 "$LOG_FILE"
  (
    cd "$ROOT/daemon"
    export HOME="$SANDBOX_HOME"
    export COMPANION_CONFIG="$SANDBOX_CONFIG"
    export COMPANION_HERALD_STATE_DIR="$STATE_DIR"
    export COMPANION_SANDBOX=1
    export COMPANION_READONLY_SHARED_STATE=1
    export NODE_ENV=production
    # Trace Herald tool calls/results into the sandbox log (HERALD_DEBUG_TOOLS=0 to silence).
    export HERALD_DEBUG_TOOLS="${HERALD_DEBUG_TOOLS:-1}"
    exec setsid node "$ENTRY" >> "$LOG_FILE" 2>&1 < /dev/null
  ) &
  local pid=$!
  unset ANTHROPIC_API_KEY
  echo "$pid" > "$PID_FILE"

  # Wait for the listener (up to ~15s).
  local i
  for i in $(seq 1 30); do
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "ERROR: sandbox daemon exited during startup. Last log lines:"
      tail -20 "$LOG_FILE" | redact
      rm -f "$PID_FILE"
      exit 1
    fi
    [ "$(port_owner "$PORT")" = "$pid" ] && break
    sleep 0.5
  done
  if [ "$(port_owner "$PORT")" != "$pid" ]; then
    echo "ERROR: sandbox did not bind port $PORT in time; stopping it."
    cmd_stop
    exit 1
  fi
  echo "Sandbox ($INSTANCE) daemon started (PID $pid) on port $PORT"
  echo "  Config: $SANDBOX_CONFIG"
  echo "  HOME:   $SANDBOX_HOME"
  echo "  State:  $STATE_DIR"
  echo "  Log:    $LOG_FILE"
  echo "  Web:    http://localhost:$PORT/web"
  grep -E "Herald" "$LOG_FILE" | redact | head -5 || true
}

cmd_stop() {
  local pid
  if ! pid="$(running_pid)"; then
    echo "Sandbox is not running."
    rm -f "$PID_FILE"
  else
    kill -TERM "$pid" 2>/dev/null || true
    local i
    for i in $(seq 1 20); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.5
    done
    if kill -0 "$pid" 2>/dev/null; then
      echo "Sandbox did not exit after SIGTERM; sending SIGKILL."
      kill -KILL "$pid" 2>/dev/null || true
      sleep 0.5
    fi
    rm -f "$PID_FILE"
    echo "Sandbox ($INSTANCE) daemon stopped (PID $pid)."
  fi
  local owner
  owner="$(port_owner "$PORT")"
  if [ -n "$owner" ]; then
    echo "WARNING: port $PORT is still held by pid $owner."
    return 1
  fi
  echo "Port $PORT is free."
  for p in $PRODUCTION_PORTS; do
    echo "Production port $p: owner pid $(port_owner "$p" || true)"
  done
}

cmd_status() {
  local pid rc=0
  if pid="$(running_pid)"; then
    local owner code
    owner="$(port_owner "$PORT")"
    code="$(curl -sS -o /dev/null -m 5 -w '%{http_code}' "http://127.0.0.1:$PORT/web/" 2>/dev/null || echo 000)"
    if [ "$owner" = "$pid" ] && [ "$code" = "200" ]; then
      echo "Sandbox ($INSTANCE) HEALTHY: PID $pid owns port $PORT; GET /web/ -> $code"
    else
      echo "Sandbox UNHEALTHY: PID $pid, port $PORT owner: ${owner:-none}, GET /web/ -> $code"
      rc=1
    fi
    grep -q "read-only shared state\|Sandbox mode" "$LOG_FILE" 2>/dev/null && echo "  Sandbox mode confirmed in log (no push, no auto-approve, shared state read-only)"
  else
    echo "Sandbox ($INSTANCE) not running. Port $PORT owner: $(port_owner "$PORT" || echo none)"
    rc=1
  fi
  [ -f "$LOG_FILE" ] && grep -E "Herald" "$LOG_FILE" | redact | tail -3 || true
  return $rc
}

HTTPS_PORT="${HERALD_HTTPS_PORT:-9890}"
TUNNEL_NAME="${HERALD_TUNNEL_NAME:-herald-voice}"
CUSH_TOOLS="${CUSH_TOOLS:-$HOME/local/src/cush-tools}"

ts_host() {
  tailscale status --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null
}

cmd_https() {
  local action="on" mode="tailscale" a
  for a in "$@"; do
    case "$a" in
      --tunnel) mode="tunnel" ;;
      *) action="$a" ;;
    esac
  done
  [ "$INSTANCE" = "default" ] || { echo "ERROR: https is for the default (user) sandbox only"; exit 2; }

  if [ "$mode" = "tunnel" ]; then
    case "$action" in
      on)
        "$CUSH_TOOLS/bin/tunnel" "$PORT" "$TUNNEL_NAME" --bg
        echo "Open: https://$TUNNEL_NAME.tunnel.cush.rocks/web/  (expires in 1h: $CUSH_TOOLS/bin/status extend $TUNNEL_NAME)"
        echo "Note: *.tunnel.cush.rocks does not resolve back to this box (no hairpin NAT); check the frpc log for 'start proxy success'." ;;
      off) "$CUSH_TOOLS/bin/status" close "$TUNNEL_NAME" ;;
      status) "$CUSH_TOOLS/bin/status" | grep -E "$TUNNEL_NAME|NAME" || echo "No tunnel named $TUNNEL_NAME" ;;
      *) echo "usage: bin/herald-sandbox https on|off|status [--tunnel]"; exit 2 ;;
    esac
    return
  fi

  command -v tailscale >/dev/null || { echo "ERROR: tailscale not installed; use --tunnel"; exit 1; }
  local host
  host="$(ts_host)"
  [ -n "$host" ] || { echo "ERROR: tailscale not logged in; use --tunnel"; exit 1; }
  # serve config is node-local (never tailnet-wide); it needs root unless an operator is set.
  local ts=(tailscale)
  [ "$(id -u)" = 0 ] || ts=(sudo -n tailscale)
  case "$action" in
    on)
      if [ -n "$(port_owner "$HTTPS_PORT")" ] && ! "${ts[@]}" serve status 2>/dev/null | grep -q ":$HTTPS_PORT"; then
        echo "ERROR: port $HTTPS_PORT is in use locally; set HERALD_HTTPS_PORT"; exit 1
      fi
      "${ts[@]}" serve --bg --https="$HTTPS_PORT" "http://127.0.0.1:$PORT" >/dev/null
      local code
      code="$(curl -sS -o /dev/null -m 10 -w '%{http_code}' "https://$host:$HTTPS_PORT/web/" 2>/dev/null || echo 000)"
      echo "HTTPS (tailnet only): https://$host:$HTTPS_PORT/web/  -> GET /web/ $code"
      echo "  Proxies to the sandbox on 127.0.0.1:$PORT. Persists across reboots until: bin/herald-sandbox https off"
      echo "  First visit on a new device: add the server (host $host, port $HTTPS_PORT, TLS on) or append #token=<your token>." ;;
    off)
      "${ts[@]}" serve --https="$HTTPS_PORT" off >/dev/null 2>&1 || true
      echo "Tailscale serve on :$HTTPS_PORT removed." ;;
    status)
      "${ts[@]}" serve status 2>/dev/null | grep -A1 ":$HTTPS_PORT" || echo "Not serving on :$HTTPS_PORT" ;;
    *) echo "usage: bin/herald-sandbox https on|off|status [--tunnel]"; exit 2 ;;
  esac
}

cmd_env() {
  echo "HERALD_SANDBOX_URL=ws://localhost:$PORT"
  echo "HERALD_SANDBOX_PORT=$PORT"
  echo "HERALD_SANDBOX_CONFIG=$SANDBOX_CONFIG"
  echo "HERALD_SANDBOX_LOG=$LOG_FILE"
}

case "${1:-}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  logs) tail -n "${2:-80}" "$LOG_FILE" | redact ;;
  env) cmd_env ;;
  https) shift; cmd_https "$@" ;;
  *)
    sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
