#!/bin/bash
# e2e-docker — end-to-end check of the Docker image and the container-aware setup wizard.
#
#   bin/e2e-docker [OUT_DIR]      (default OUT_DIR: ./e2e-docker-shots)
#
# Builds the image as companion-e2e:local, starts it under its own compose
# project (companion-e2e) with throwaway volumes and a throwaway projects dir
# on 127.0.0.1:E2E_PORT (default 9744; never 9877/9878), checks /health, then
# drives the wizard in headless Chrome (web/e2e/docker-wizard.cjs): pairing by
# the code from `docker compose logs`, the Docker branches of every step, and
# (INSTALL_CLAUDE=1, default) installing Claude Code from the wizard (never
# logs in). Tears everything down at the end (KEEP=1 leaves it running).
# Env: PLAYWRIGHT_CORE (path to playwright-core), CHROME, E2E_PORT, KEEP.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$(realpath -m "${1:-./e2e-docker-shots}")"
PORT="${E2E_PORT:-9744}"
case " 9877 9878 9889 " in *" $PORT "*) echo "Refusing production port $PORT"; exit 1 ;; esac
WORK="$(mktemp -d -t companion-e2e-docker-XXXXXX)"
mkdir -p "$WORK/projects/demo-app"
echo "# demo" > "$WORK/projects/demo-app/README.md"
cat > "$WORK/e2e.env" <<EOF
COMPOSE_PROJECT_NAME=companion-e2e
COMPANION_IMAGE=companion-e2e:local
COMPANION_PROJECTS=$WORK/projects
COMPANION_PORT=$PORT
COMPANION_BIND=127.0.0.1
COMPANION_NAME=Docker E2E
PUID=$(id -u)
PGID=$(id -g)
EOF
export COMPANION_ENV_FILE="$WORK/e2e.env" COMPOSE_PROJECT_NAME=companion-e2e
cleanup() {
  if [ "${KEEP:-0}" != 1 ]; then
    "$ROOT/bin/docker" down -v --remove-orphans >/dev/null 2>&1 || true
    docker image rm companion-e2e:local >/dev/null 2>&1 || true
    rm -rf "$WORK"
  else
    echo "KEEP=1: stack left running (project companion-e2e, env $WORK/e2e.env)"
  fi
}
trap cleanup EXIT
[ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null

"$ROOT/bin/docker" build --tag companion-e2e:local
"$ROOT/bin/docker" up >/dev/null
for i in $(seq 1 30); do curl -fsS "http://127.0.0.1:$PORT/health" >/dev/null 2>&1 && break; sleep 1; done
echo "/health: $(curl -fsS "http://127.0.0.1:$PORT/health")"

rm -rf "$OUT"
rc=0
PORT="$PORT" OUT="$OUT" INSTALL_CLAUDE="${INSTALL_CLAUDE:-1}" \
  LOGS_CMD="docker compose --env-file $WORK/e2e.env logs --no-color companion" \
  timeout 600 node "$ROOT/web/e2e/docker-wizard.cjs" || rc=$?
# Concierge prerequisites inside the container (claude from the wizard's
# install, the seeded concierge dir, the baked-in MCP).
if [ "${INSTALL_CLAUDE:-1}" = 1 ]; then
  "$ROOT/bin/docker" concierge check || rc=1
else
  "$ROOT/bin/docker" exec test -f /home/companion/.companion/concierge/.mcp.json.template || rc=1
  "$ROOT/bin/docker" exec node -e 'require("/app/mcp/node_modules/@modelcontextprotocol/sdk/package.json")' || rc=1
fi
echo "Screenshots: $OUT"
exit $rc
