#!/bin/bash
# companion — Top-level entry point for the Companion daemon.
#
# Handles building, backgrounding, and process management in the shell,
# then delegates everything else to the Node.js CLI (daemon/dist/index.js).
#
# Usage:
#   bin/companion              Start the daemon (background)
#   bin/companion start -f     Start in foreground (for debugging)
#   bin/companion setup        First-time setup (creates config, prints connection info)
#   bin/companion stop         Stop a running daemon
#   bin/companion status       Show daemon status
#   bin/companion install-secrets   Materialize daemon secrets (Herald key) + systemd drop-in
#   bin/companion herald-provider   Set herald.provider in the live config (idempotent)
#   bin/companion herald-set        Set one herald.* setting (budget, cache, trigger trust)
#   bin/companion trigger-token     Herald remote-trigger tokens: create | rotate | revoke | list | migrate | show-path
#   bin/companion publish-update    Put a desktop build on the auto-update feed (--run <id|latest> | --from <dir>)
#   bin/companion help         Show all commands
#
# See README.md for full documentation.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
DAEMON_DIR="$ROOT/daemon"
WEB_DIR="$ROOT/web"
ENTRY="$DAEMON_DIR/dist/index.js"
CONFIG_DIR="$HOME/.companion"
PID_FILE="$CONFIG_DIR/daemon.pid"
# Secrets env file materialized by `install-secrets` (chmod 600, never in git or config.json).
SECRETS_ENV="${COMPANION_SECRETS_ENV:-$CONFIG_DIR/herald.env}"
SECRETS_MANIFEST="$ROOT/.cush-secrets"
CUSH_INJECT="${CUSH_INJECT:-$HOME/local/src/cush-tools/bin/inject}"
SYSTEMD_DROPIN_DIR="$HOME/.config/systemd/user/companion.service.d"
SYSTEMD_DROPIN="$SYSTEMD_DROPIN_DIR/secrets.conf"
# Herald remote-trigger token (triggers only; chmod 600, never in git or config.json).
# The daemon reads the same default path (override: COMPANION_HERALD_TRIGGER_TOKEN_FILE).
TRIGGER_TOKEN_FILE="${COMPANION_HERALD_TRIGGER_TOKEN_FILE:-$CONFIG_DIR/herald-trigger.token}"

# Platform-aware log location
if [[ "$OSTYPE" == darwin* ]]; then
  LOG_FILE="$HOME/Library/Logs/companion.log"
else
  LOG_FILE="$CONFIG_DIR/daemon.log"
fi

# --- Check for Node.js ---
if ! command -v node &>/dev/null; then
  echo "ERROR: Node.js is not installed."
  echo ""
  echo "Install it from: https://nodejs.org/"
  echo "  or via nvm:    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash"
  exit 1
fi

# --- Build helpers ---

needs_npm_install() {
  local dir="$1"
  # No node_modules at all
  if [ ! -d "$dir/node_modules" ]; then
    return 0
  fi
  # package-lock.json is newer than the install marker
  if [ -f "$dir/package-lock.json" ] && [ -f "$dir/node_modules/.package-lock.json" ]; then
    if [ "$dir/package-lock.json" -nt "$dir/node_modules/.package-lock.json" ]; then
      return 0
    fi
  fi
  return 1
}

needs_daemon_build() {
  # No build output at all
  if [ ! -f "$ENTRY" ]; then
    return 0
  fi
  # Any .ts source newer than the entry point
  if find "$DAEMON_DIR/src" -name '*.ts' -newer "$ENTRY" -print -quit 2>/dev/null | grep -q .; then
    return 0
  fi
  return 1
}

needs_web_build() {
  # No build output at all
  if [ ! -f "$WEB_DIR/dist/index.html" ]; then
    return 0
  fi
  # Any source file under web/src/ newer than dist/index.html
  if find "$WEB_DIR/src" -type f -newer "$WEB_DIR/dist/index.html" -print -quit 2>/dev/null | grep -q .; then
    return 0
  fi
  # Top-level config/entry files newer than dist/index.html
  for f in "$WEB_DIR/package.json" "$WEB_DIR/package-lock.json" "$WEB_DIR/vite.config.ts" "$WEB_DIR/vite.config.js" "$WEB_DIR/index.html" "$WEB_DIR/tsconfig.json"; do
    if [ -f "$f" ] && [ "$f" -nt "$WEB_DIR/dist/index.html" ]; then
      return 0
    fi
  done
  return 1
}

build_daemon() {
  local did_work=false

  if needs_npm_install "$DAEMON_DIR"; then
    echo "Installing daemon dependencies..."
    (cd "$DAEMON_DIR" && npm install --include=dev) || { echo "ERROR: npm install failed in daemon/"; exit 1; }
    did_work=true
  fi

  if needs_daemon_build; then
    echo "Building daemon..."
    (cd "$DAEMON_DIR" && npm run build) || { echo "ERROR: daemon build failed"; exit 1; }
    did_work=true
  fi

  if $did_work; then
    echo ""
  fi
}

build_web() {
  local did_work=false

  if needs_npm_install "$WEB_DIR"; then
    echo "Installing web dependencies..."
    (cd "$WEB_DIR" && npm install --include=dev) || { echo "ERROR: npm install failed in web/"; exit 1; }
    did_work=true
  fi

  if needs_web_build; then
    echo "Building web client..."
    (cd "$WEB_DIR" && npm run build) || { echo "ERROR: web client build failed"; exit 1; }
    did_work=true
  fi

  if $did_work; then
    echo ""
  fi
}

# --- Secrets: install-secrets ---
# Resolves the refs in .cush-secrets (Infisical) into $SECRETS_ENV at chmod 600,
# outside the repo, and (Linux) installs a systemd drop-in so the service loads
# it via EnvironmentFile=-. Never restarts the daemon: the key takes effect on
# the next (user-approved) restart.
cmd_install_secrets() {
  local want_unit=true refresh_on_start=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-unit) want_unit=false ;;
      --refresh-on-start) refresh_on_start=true ;;
      -h|--help)
        cat <<USAGE
Usage: companion install-secrets [--no-unit] [--refresh-on-start]

  Materializes $SECRETS_MANIFEST into $SECRETS_ENV (chmod 600) via cush-tools inject,
  then writes the systemd drop-in $SYSTEMD_DROPIN:
      [Service]
      EnvironmentFile=-$SECRETS_ENV
  and runs 'systemctl --user daemon-reload'. Does NOT restart the daemon.

  --no-unit           Only write the env file; leave systemd alone.
  --refresh-on-start  Also add 'ExecStartPre=-' that re-runs inject on every service
                      start (picks up key rotation; failures never block startup).
USAGE
        return 0 ;;
      *) echo "Unknown option: $1 (see: companion install-secrets --help)"; return 2 ;;
    esac
    shift
  done

  if [ ! -x "$CUSH_INJECT" ]; then
    echo "ERROR: cush-tools inject not found at $CUSH_INJECT (set CUSH_INJECT to override)."
    return 1
  fi
  if [ ! -f "$SECRETS_MANIFEST" ]; then
    echo "ERROR: secrets manifest not found: $SECRETS_MANIFEST"
    return 1
  fi

  mkdir -p "$(dirname "$SECRETS_ENV")"
  # --no-prompt: never spawn a secure-entry form from a script context. To add a
  # missing key, use cush-tools secure-entry --save-to-inf, then re-run this.
  if ! "$CUSH_INJECT" --manifest "$SECRETS_MANIFEST" --out "$SECRETS_ENV" --no-prompt; then
    echo "ERROR: inject failed; $SECRETS_ENV was not updated. No values were printed."
    return 1
  fi
  chmod 600 "$SECRETS_ENV"
  echo "Wrote $SECRETS_ENV (mode 600; keys: $(cut -d= -f1 "$SECRETS_ENV" | paste -sd, -))"

  if ! $want_unit; then
    return 0
  fi
  if [[ "$OSTYPE" == darwin* ]]; then
    echo "macOS: launchd does not read env files. bin/companion sources $SECRETS_ENV itself when it"
    echo "launches the daemon; for the launchd agent, add the key to its EnvironmentVariables."
    return 0
  fi

  mkdir -p "$SYSTEMD_DROPIN_DIR"
  local tmp="$SYSTEMD_DROPIN.tmp.$$"
  {
    echo "# Managed by 'bin/companion install-secrets'. Loads daemon secrets (e.g. ANTHROPIC_API_KEY"
    echo "# for Herald) from a chmod-600 file outside the repo. '-' = optional: a missing file"
    echo "# never blocks startup (Herald just reports the brain as unconfigured)."
    echo "[Service]"
    if $refresh_on_start; then
      # systemd's PATH lacks ~/.local/bin (infisical CLI); pin the dirs inject needs.
      local inj_path="/usr/local/bin:/usr/bin:/bin"
      local d
      for d in "$(dirname "$(command -v infisical 2>/dev/null || echo /usr/bin/x)")" "$(dirname "$(command -v python3)")"; do
        case ":$inj_path:" in *":$d:"*) ;; *) inj_path="$d:$inj_path" ;; esac
      done
      echo "ExecStartPre=-/usr/bin/env PATH=$inj_path $CUSH_INJECT --manifest $SECRETS_MANIFEST --out $SECRETS_ENV --no-prompt"
    fi
    echo "EnvironmentFile=-$SECRETS_ENV"
  } > "$tmp"
  if [ -f "$SYSTEMD_DROPIN" ] && cmp -s "$tmp" "$SYSTEMD_DROPIN"; then
    rm -f "$tmp"
    echo "systemd drop-in already up to date: $SYSTEMD_DROPIN"
  else
    mv "$tmp" "$SYSTEMD_DROPIN"
    echo "Wrote systemd drop-in: $SYSTEMD_DROPIN"
    if command -v systemctl &>/dev/null; then
      systemctl --user daemon-reload && echo "Reloaded systemd user units (daemon NOT restarted)."
    fi
  fi
  echo ""
  echo "The running daemon still has its old environment. The key takes effect on the next"
  echo "daemon restart, which needs your explicit sign-off."
}

# --- Config: herald-provider ---
# Idempotently sets herald.provider (and optionally herald.model) in the live
# config, preserving every other key and the file's permissions. Atomic write.
cmd_herald_provider() {
  local provider="" model="" config="${COMPANION_CONFIG:-${CONFIG_PATH:-$CONFIG_DIR/config.json}}"
  while [ $# -gt 0 ]; do
    case "$1" in
      anthropic|openai_compatible) provider="$1" ;;
      --model) model="${2:-}"; shift ;;
      --config) config="${2:-}"; shift ;;
      -h|--help)
        echo "Usage: companion herald-provider <anthropic|openai_compatible> [--model NAME] [--config PATH]"
        echo "  Sets herald.provider (and herald.model if given) in $config."
        echo "  Idempotent; preserves all other settings. Takes effect on the next daemon restart."
        return 0 ;;
      *) echo "Unknown argument: $1 (see: companion herald-provider --help)"; return 2 ;;
    esac
    shift
  done
  if [ -z "$provider" ]; then
    echo "Usage: companion herald-provider <anthropic|openai_compatible> [--model NAME] [--config PATH]"
    return 2
  fi
  if [ ! -f "$config" ]; then
    echo "ERROR: config not found: $config (run 'companion setup' first)"
    return 1
  fi
  CFG="$config" PROVIDER="$provider" MODEL="$model" node -e '
    const fs = require("fs"), path = require("path");
    const file = process.env.CFG;
    const cfg = JSON.parse(fs.readFileSync(file, "utf-8"));
    const had = cfg.herald && typeof cfg.herald === "object" && !Array.isArray(cfg.herald);
    const herald = had ? cfg.herald : {};
    const before = JSON.stringify(herald);
    herald.provider = process.env.PROVIDER;
    if (process.env.MODEL) herald.model = process.env.MODEL;
    const desc = `herald.provider="${herald.provider}"${herald.model ? `, herald.model="${herald.model}"` : ""}`;
    if (had && before === JSON.stringify(herald)) {
      console.log(`Already set: ${desc} in ${file}; no change.`);
      process.exit(0);
    }
    cfg.herald = herald;
    const mode = fs.statSync(file).mode & 0o777;
    const tmp = path.join(path.dirname(file), `.${path.basename(file)}.${process.pid}.tmp`);
    fs.writeFileSync(tmp, JSON.stringify(cfg, null, 2) + "\n", { mode });
    fs.chmodSync(tmp, mode);
    fs.renameSync(tmp, file);
    console.log(`Set ${desc} in ${file}`);
    console.log("Takes effect on the next daemon restart (needs your sign-off).");
  '
}

# --- Herald: herald-set ---
# Set one whitelisted herald.* setting in the live config (JSON value), keeping
# everything else. `--unset` removes it. Takes effect on the next restart.
HERALD_SET_KEYS="monthly_budget_usd cache_ttl prompt_cache trigger_home_hosts trigger_public_listen trigger_trusted_proxies"
cmd_herald_set() {
  local key="" value="" unset_it="" config="${COMPANION_CONFIG:-${CONFIG_PATH:-$CONFIG_DIR/config.json}}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --config) config="${2:-}"; shift ;;
      --unset) unset_it=1 ;;
      -h|--help)
        echo "Usage: companion herald-set <key> <json-value> | --unset <key> [--config PATH]"
        echo "  Keys: $HERALD_SET_KEYS"
        echo "  e.g.  companion herald-set trigger_home_hosts '[\"dev.example.org\"]'"
        echo "        companion herald-set monthly_budget_usd 5"
        echo "  Preserves all other settings. Takes effect on the next daemon restart."
        return 0 ;;
      *) if [ -z "$key" ]; then key="$1"; elif [ -z "$value" ]; then value="$1"; else echo "Unexpected argument: $1"; return 2; fi ;;
    esac
    shift
  done
  if [ -z "$key" ] || { [ -z "$unset_it" ] && [ -z "$value" ]; }; then
    echo "Usage: companion herald-set <key> <json-value> | --unset <key>  (see --help)"; return 2
  fi
  case " $HERALD_SET_KEYS " in *" $key "*) ;; *) echo "Unknown key: $key (allowed: $HERALD_SET_KEYS)"; return 2 ;; esac
  [ -f "$config" ] || { echo "ERROR: config not found: $config"; return 1; }
  CFG="$config" KEY="$key" VALUE="$value" UNSET="$unset_it" node -e '
    const fs = require("fs"), path = require("path");
    const file = process.env.CFG, key = process.env.KEY;
    let value;
    if (!process.env.UNSET) {
      try { value = JSON.parse(process.env.VALUE); } catch { console.error("Value must be JSON, e.g. 5, true, \"1h\", [\"host\"]"); process.exit(2); }
      const ok = {
        monthly_budget_usd: (v) => typeof v === "number" && v > 0 && v <= 10000,
        cache_ttl: (v) => v === "5m" || v === "1h",
        prompt_cache: (v) => typeof v === "boolean",
        trigger_public_listen: (v) => typeof v === "boolean",
        trigger_home_hosts: (v) => Array.isArray(v) && v.every((x) => typeof x === "string" && x.length > 0),
        trigger_trusted_proxies: (v) => Array.isArray(v) && v.every((x) => typeof x === "string" && x.length > 0),
      }[key];
      if (!ok(value)) { console.error(`Invalid value for ${key}`); process.exit(2); }
    }
    const cfg = JSON.parse(fs.readFileSync(file, "utf-8"));
    const herald = cfg.herald && typeof cfg.herald === "object" && !Array.isArray(cfg.herald) ? cfg.herald : {};
    const before = JSON.stringify(herald);
    if (process.env.UNSET) delete herald[key]; else herald[key] = value;
    if (before === JSON.stringify(herald)) { console.log(`No change: herald.${key} in ${file}`); process.exit(0); }
    cfg.herald = herald;
    const mode = fs.statSync(file).mode & 0o777;
    const tmp = path.join(path.dirname(file), `.${path.basename(file)}.${process.pid}.tmp`);
    fs.writeFileSync(tmp, JSON.stringify(cfg, null, 2) + "\n", { mode });
    fs.chmodSync(tmp, mode);
    fs.renameSync(tmp, file);
    console.log(process.env.UNSET ? `Removed herald.${key} from ${file}` : `Set herald.${key}=${JSON.stringify(value)} in ${file}`);
    console.log("Takes effect on the next daemon restart (needs your sign-off).");
  '
}

# --- Herald: trigger-token ---
# Credentials that can ONLY fire Herald triggers (POST /herald/trigger, or the
# herald_trigger WS request); they cannot read sessions or send input. One per
# device, by name. The daemon only ever sees the registry
# (herald-trigger-tokens.json: name + SHA-256, never the token); each token's
# secret is written once to a 0600 file for copying to that device. The
# original single token file keeps working as the token named "default".
# Never printed: only paths and a masked preview. The daemon re-reads both
# files when they change, so create / rotate / revoke need no restart.
TRIGGER_REGISTRY="${COMPANION_HERALD_TRIGGER_TOKENS_FILE:-$(dirname "$TRIGGER_TOKEN_FILE")/herald-trigger-tokens.json}"
TRIGGER_SECRETS_DIR="$(dirname "$TRIGGER_TOKEN_FILE")/herald-triggers"

trigger_token_preview() {
  local tok
  tok="$(cat "$1")"
  echo "${tok:0:4}…(${#tok} chars)"
}

trigger_secret_file() {
  if [ "$1" = "default" ]; then echo "$TRIGGER_TOKEN_FILE"; else echo "$TRIGGER_SECRETS_DIR/$1.token"; fi
}

# Registry operations (JSON, atomic 0600 writes). Usage:
#   trigger_registry list
#   trigger_registry status NAME                 -> active | revoked | missing
#   trigger_registry put NAME SECRET_FILE        (register / replace NAME with that token's hash)
#   trigger_registry revoke NAME [LEGACY_FILE]   (registers the legacy token first when NAME=default)
trigger_registry() {
  REG="$TRIGGER_REGISTRY" LEGACY="$TRIGGER_TOKEN_FILE" SECRETS="$TRIGGER_SECRETS_DIR" node -e '
    const fs = require("fs"), path = require("path"), crypto = require("crypto");
    const [op, name, file] = process.argv.slice(1);
    const reg = process.env.REG, legacy = process.env.LEGACY, secrets = process.env.SECRETS;
    const sha = (p) => crypto.createHash("sha256").update(fs.readFileSync(p, "utf8").trim(), "utf8").digest("hex");
    let data = { version: 1, tokens: [] };
    try { data = JSON.parse(fs.readFileSync(reg, "utf8")); } catch (e) { if (e.code !== "ENOENT") { console.error("ERROR: cannot read " + reg + ": " + e.message); process.exit(1); } }
    if (!Array.isArray(data.tokens)) data.tokens = [];
    const save = () => {
      fs.mkdirSync(path.dirname(reg), { recursive: true, mode: 0o700 });
      const tmp = reg + ".tmp-" + process.pid;
      fs.writeFileSync(tmp, JSON.stringify(data, null, 2) + "\n", { mode: 0o600 });
      fs.chmodSync(tmp, 0o600);
      fs.renameSync(tmp, reg);
    };
    const find = (n) => data.tokens.find((t) => t.name === n);
    const legacyHash = () => { try { const t = fs.readFileSync(legacy, "utf8").trim(); return t.length >= 32 ? crypto.createHash("sha256").update(t, "utf8").digest("hex") : null; } catch { return null; } };
    if (op === "status") {
      const t = find(name);
      if (t) { console.log(t.revokedAt ? "revoked" : "active"); process.exit(0); }
      if (name === "default" && legacyHash()) { console.log("active"); process.exit(0); }
      console.log("missing"); process.exit(0);
    }
    if (op === "put") {
      const entry = { name, sha256: sha(file), createdAt: new Date().toISOString() };
      data.tokens = data.tokens.filter((t) => t.name !== name).concat([entry]);
      save(); process.exit(0);
    }
    if (op === "revoke") {
      let t = find(name);
      if (!t && name === "default") {
        const h = legacyHash();
        if (h) { t = { name, sha256: h, createdAt: new Date().toISOString(), source: "legacy" }; data.tokens.push(t); }
      }
      if (!t) { console.error("No trigger token named \"" + name + "\""); process.exit(3); }
      if (t.revokedAt) { console.log("already revoked"); process.exit(0); }
      t.revokedAt = new Date().toISOString();
      save(); process.exit(0);
    }
    if (op === "migrate") {
      const h = legacyHash();
      if (!h) { console.log("no legacy token file"); process.exit(0); }
      if (data.tokens.some((t) => t.sha256 === h)) { console.log("already registered"); process.exit(0); }
      if (find("default")) { console.error("A different token is already registered as \"default\""); process.exit(3); }
      data.tokens.push({ name: "default", sha256: h, createdAt: new Date().toISOString(), source: "legacy" });
      save(); console.log("registered"); process.exit(0);
    }
    if (op === "list") {
      const rows = data.tokens.map((t) => ({ ...t }));
      const h = legacyHash();
      if (h && !rows.some((t) => t.sha256 === h)) rows.unshift({ name: "default", createdAt: null, source: "legacy-unregistered" });
      if (rows.length === 0) { console.log("No trigger tokens. Create one: companion trigger-token create <device-name>"); process.exit(0); }
      const secretFile = (n) => (n === "default" ? legacy : path.join(secrets, n + ".token"));
      console.log(["NAME".padEnd(20), "STATUS".padEnd(9), "CREATED (UTC)".padEnd(20), "SECRET FILE"].join(" "));
      for (const t of rows) {
        const status = t.revokedAt ? "revoked" : "active";
        const created = t.createdAt ? t.createdAt.slice(0, 16).replace("T", " ") : (t.source === "legacy-unregistered" ? "(legacy file)" : "?");
        const sf = secretFile(t.name);
        const has = fs.existsSync(sf) ? sf : "(gone)";
        console.log([t.name.padEnd(20), status.padEnd(9), created.padEnd(20), t.revokedAt ? "-" : has].join(" "));
      }
      if (h && !data.tokens.some((t) => t.sha256 === h))
        console.log("\nNote: \"default\" is the original single token (deprecated, still accepted). Run `companion trigger-token migrate` to register it by name.");
      process.exit(0);
    }
    console.error("unknown registry op " + op); process.exit(2);
  ' "$@"
}

trigger_new_secret() {
  # trigger_new_secret FILE: write a fresh 64-hex token to FILE (0600, atomic).
  local file="$1" dir tmp tok
  dir="$(dirname "$file")"
  mkdir -p "$dir"
  chmod 700 "$dir" 2>/dev/null || true
  tok="$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')"
  if [ "${#tok}" -ne 64 ]; then
    echo "ERROR: could not read /dev/urandom" >&2
    return 1
  fi
  tmp="$dir/.herald-trigger.tmp.$$"
  ( umask 077; printf '%s\n' "$tok" > "$tmp" )
  chmod 600 "$tmp"
  mv -f "$tmp" "$file"
  unset tok
}

trigger_valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$ ]]
}

cmd_trigger_token() {
  local sub="${1:-}"
  local name="${2:-default}"
  case "$sub" in
    create|rotate)
      if ! trigger_valid_name "$name"; then
        echo "Invalid name '$name': letters, digits, dot, dash, underscore (max 40), e.g. gaming-pc" >&2
        return 2
      fi
      local file status
      file="$(trigger_secret_file "$name")"
      status="$(trigger_registry status "$name")" || return 1
      if [ "$sub" = "create" ] && [ "$status" = "active" ]; then
        echo "A trigger token named \"$name\" already exists (companion trigger-token list)."
        echo "Use 'companion trigger-token rotate $name' to replace it (that device stops working until updated)."
        return 0
      fi
      trigger_new_secret "$file" || return 1
      trigger_registry put "$name" "$file" || return 1
      if [ "$sub" = "rotate" ]; then echo "Rotated the Herald trigger token \"$name\"."; else echo "Created the Herald trigger token \"$name\"."; fi
      echo "  Secret:   $file (mode 600)"
      echo "  Preview:  $(trigger_token_preview "$file")"
      echo "  Registry: $TRIGGER_REGISTRY"
      echo ""
      echo "The running daemon picks it up on the next trigger (no restart)."
      echo "Copy it to that device without pasting it in chat, e.g.:"
      echo "  cat \"$file\" | ~/local/src/cush-tools/bin/exchange herald-trigger --bg"
      echo "  (then: ~/local/src/cush-tools/bin/status close herald-trigger)"
      echo "Setup per machine: triggers/README.md"
      ;;
    revoke)
      if [ -z "${2:-}" ]; then echo "Usage: companion trigger-token revoke <name>" >&2; return 2; fi
      trigger_valid_name "$name" || { echo "Invalid name '$name'" >&2; return 2; }
      trigger_registry revoke "$name" || return $?
      local file
      file="$(trigger_secret_file "$name")"
      rm -f "$file"
      echo "Revoked the Herald trigger token \"$name\" (its secret file is deleted)."
      echo "Takes effect on that device's next trigger (no restart)."
      ;;
    list)
      trigger_registry list
      ;;
    migrate)
      local out
      out="$(trigger_registry migrate)" || return $?
      case "$out" in
        registered) echo "Registered the original trigger token as \"default\" (it keeps working; list / revoke it by name)." ;;
        "already registered") echo "The original trigger token is already registered." ;;
        *) echo "Nothing to migrate: $out" ;;
      esac
      ;;
    show-path)
      local file
      file="$(trigger_secret_file "$name")"
      echo "$file"
      if [ -f "$file" ]; then
        local mode
        mode="$(stat -c '%a' "$file" 2>/dev/null || stat -f '%Lp' "$file")"
        echo "  exists, mode $mode, preview $(trigger_token_preview "$file")" >&2
        [ "$mode" = "600" ] || echo "  WARNING: the daemon ignores this file unless it is mode 600 (chmod 600 it)" >&2
      else
        echo "  not present (companion trigger-token create $name)" >&2
      fi
      ;;
    -h|--help|help|"")
      echo "Usage: companion trigger-token <command> [name]"
      echo "  create [name]   make a trigger token for one device (default name: default)"
      echo "  rotate [name]   replace it (that device needs the new one)"
      echo "  revoke <name>   refuse it from now on (and delete its secret file)"
      echo "  list            names, status, and where each secret file is"
      echo "  migrate         register the original single token as \"default\""
      echo "  show-path [name]  the secret file (and, on stderr, a masked preview)"
      echo ""
      echo "  Tokens can only fire Herald triggers. Secrets: $TRIGGER_SECRETS_DIR/<name>.token"
      echo "  (\"default\": $TRIGGER_TOKEN_FILE). Override with COMPANION_HERALD_TRIGGER_TOKEN_FILE /"
      echo "  COMPANION_HERALD_TRIGGER_TOKENS_FILE (the daemon must see the same values)."
      [ -n "$sub" ] && return 0 || return 2 ;;
    *) echo "Unknown subcommand: $sub (see: companion trigger-token --help)"; return 2 ;;
  esac
}

case "${1:-}" in
  install-secrets) shift; cmd_install_secrets "$@"; exit $? ;;
  herald-provider) shift; cmd_herald_provider "$@"; exit $? ;;
  trigger-token) shift; cmd_trigger_token "$@"; exit $? ;;
  herald-set) shift; cmd_herald_set "$@"; exit $? ;;
  publish-update) shift; exec node "$DAEMON_DIR/scripts/publish-update.js" "$@" ;;
esac

# Every other launch path (foreground, background, CLI-driven restart) loads the
# same secrets file the systemd drop-in uses, so Herald's key reaches the daemon
# however it is launched. Exported only into this process tree.
if [ -f "$SECRETS_ENV" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$SECRETS_ENV"
  set +a
fi

# --- Always ensure daemon is built ---
build_daemon

# --- Setup: also build web client ---
if [ "${1:-}" = "setup" ]; then
  build_web
  exec node "$ENTRY" "$@"
fi

# --- Start command (default) ---
if [ "${1:-}" = "" ] || [ "${1:-}" = "start" ]; then
  # Parse flags
  FOREGROUND=false
  shift 2>/dev/null || true  # consume "start" if present
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--foreground)
        FOREGROUND=true
        shift
        ;;
      *)
        echo "Unknown option: $1"
        echo "Usage: companion start [-f|--foreground]"
        exit 1
        ;;
    esac
  done

  # Also build web client for start (daemon serves it)
  build_web

  # Check if already running
  if [ -f "$PID_FILE" ]; then
    EXISTING_PID=$(cat "$PID_FILE" 2>/dev/null || true)
    if [ -n "$EXISTING_PID" ] && kill -0 "$EXISTING_PID" 2>/dev/null; then
      echo "Daemon is already running (PID $EXISTING_PID)"
      echo "Use 'companion stop' to stop it first, or 'companion restart' to restart."
      exit 1
    fi
    # Stale PID file — clean up
    rm -f "$PID_FILE"
  fi

  if $FOREGROUND; then
    exec node "$ENTRY" start
  fi

  # Background start
  mkdir -p "$(dirname "$LOG_FILE")"
  nohup node "$ENTRY" start >> "$LOG_FILE" 2>&1 &
  DAEMON_PID=$!

  # Write PID file (the node CLI also writes one, but we write early for the liveness check)
  mkdir -p "$CONFIG_DIR"
  echo "$DAEMON_PID" > "$PID_FILE"

  # 1-second liveness check
  sleep 1
  if ! kill -0 "$DAEMON_PID" 2>/dev/null; then
    echo "ERROR: Daemon exited immediately after starting."
    echo ""
    echo "Last 20 lines of log ($LOG_FILE):"
    tail -20 "$LOG_FILE" 2>/dev/null || echo "(no log output)"
    rm -f "$PID_FILE"
    exit 1
  fi

  echo "Daemon started (PID $DAEMON_PID)"
  echo "  Logs: $LOG_FILE"
  exit 0
fi

# --- Restart: rebuild web client too (daemon serves it) ---
if [ "${1:-}" = "restart" ]; then
  build_web
fi

# --- All other commands delegate to node CLI ---
exec node "$ENTRY" "$@"
