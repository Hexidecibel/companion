#!/bin/bash
# companion — Top-level entry point for the Companion daemon.
#
# Handles building, backgrounding, and process management in the shell,
# then delegates everything else to the Node.js CLI (daemon/dist/index.js).
#
# Usage:
#   bin/companion              Start the daemon (background)
#   bin/companion start -f     Start in foreground (for debugging)
#   bin/companion setup        First-time setup (creates config, prints connection info)
#   bin/companion stop         Stop a running daemon
#   bin/companion status       Show daemon status
#   bin/companion install-secrets   Materialize daemon secrets (Herald key) + systemd drop-in
#   bin/companion herald-provider   Set herald.provider in the live config (idempotent)
#   bin/companion help         Show all commands
#
# See README.md for full documentation.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
DAEMON_DIR="$ROOT/daemon"
WEB_DIR="$ROOT/web"
ENTRY="$DAEMON_DIR/dist/index.js"
CONFIG_DIR="$HOME/.companion"
PID_FILE="$CONFIG_DIR/daemon.pid"
# Secrets env file materialized by `install-secrets` (chmod 600, never in git or config.json).
SECRETS_ENV="${COMPANION_SECRETS_ENV:-$CONFIG_DIR/herald.env}"
SECRETS_MANIFEST="$ROOT/.cush-secrets"
CUSH_INJECT="${CUSH_INJECT:-$HOME/local/src/cush-tools/bin/inject}"
SYSTEMD_DROPIN_DIR="$HOME/.config/systemd/user/companion.service.d"
SYSTEMD_DROPIN="$SYSTEMD_DROPIN_DIR/secrets.conf"

# Platform-aware log location
if [[ "$OSTYPE" == darwin* ]]; then
  LOG_FILE="$HOME/Library/Logs/companion.log"
else
  LOG_FILE="$CONFIG_DIR/daemon.log"
fi

# --- Check for Node.js ---
if ! command -v node &>/dev/null; then
  echo "ERROR: Node.js is not installed."
  echo ""
  echo "Install it from: https://nodejs.org/"
  echo "  or via nvm:    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash"
  exit 1
fi

# --- Build helpers ---

needs_npm_install() {
  local dir="$1"
  # No node_modules at all
  if [ ! -d "$dir/node_modules" ]; then
    return 0
  fi
  # package-lock.json is newer than the install marker
  if [ -f "$dir/package-lock.json" ] && [ -f "$dir/node_modules/.package-lock.json" ]; then
    if [ "$dir/package-lock.json" -nt "$dir/node_modules/.package-lock.json" ]; then
      return 0
    fi
  fi
  return 1
}

needs_daemon_build() {
  # No build output at all
  if [ ! -f "$ENTRY" ]; then
    return 0
  fi
  # Any .ts source newer than the entry point
  if find "$DAEMON_DIR/src" -name '*.ts' -newer "$ENTRY" -print -quit 2>/dev/null | grep -q .; then
    return 0
  fi
  return 1
}

needs_web_build() {
  # No build output at all
  if [ ! -f "$WEB_DIR/dist/index.html" ]; then
    return 0
  fi
  # Any source file under web/src/ newer than dist/index.html
  if find "$WEB_DIR/src" -type f -newer "$WEB_DIR/dist/index.html" -print -quit 2>/dev/null | grep -q .; then
    return 0
  fi
  # Top-level config/entry files newer than dist/index.html
  for f in "$WEB_DIR/package.json" "$WEB_DIR/package-lock.json" "$WEB_DIR/vite.config.ts" "$WEB_DIR/vite.config.js" "$WEB_DIR/index.html" "$WEB_DIR/tsconfig.json"; do
    if [ -f "$f" ] && [ "$f" -nt "$WEB_DIR/dist/index.html" ]; then
      return 0
    fi
  done
  return 1
}

build_daemon() {
  local did_work=false

  if needs_npm_install "$DAEMON_DIR"; then
    echo "Installing daemon dependencies..."
    (cd "$DAEMON_DIR" && npm install --include=dev) || { echo "ERROR: npm install failed in daemon/"; exit 1; }
    did_work=true
  fi

  if needs_daemon_build; then
    echo "Building daemon..."
    (cd "$DAEMON_DIR" && npm run build) || { echo "ERROR: daemon build failed"; exit 1; }
    did_work=true
  fi

  if $did_work; then
    echo ""
  fi
}

build_web() {
  local did_work=false

  if needs_npm_install "$WEB_DIR"; then
    echo "Installing web dependencies..."
    (cd "$WEB_DIR" && npm install --include=dev) || { echo "ERROR: npm install failed in web/"; exit 1; }
    did_work=true
  fi

  if needs_web_build; then
    echo "Building web client..."
    (cd "$WEB_DIR" && npm run build) || { echo "ERROR: web client build failed"; exit 1; }
    did_work=true
  fi

  if $did_work; then
    echo ""
  fi
}

# --- Secrets: install-secrets ---
# Resolves the refs in .cush-secrets (Infisical) into $SECRETS_ENV at chmod 600,
# outside the repo, and (Linux) installs a systemd drop-in so the service loads
# it via EnvironmentFile=-. Never restarts the daemon: the key takes effect on
# the next (user-approved) restart.
cmd_install_secrets() {
  local want_unit=true refresh_on_start=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-unit) want_unit=false ;;
      --refresh-on-start) refresh_on_start=true ;;
      -h|--help)
        cat <<USAGE
Usage: companion install-secrets [--no-unit] [--refresh-on-start]

  Materializes $SECRETS_MANIFEST into $SECRETS_ENV (chmod 600) via cush-tools inject,
  then writes the systemd drop-in $SYSTEMD_DROPIN:
      [Service]
      EnvironmentFile=-$SECRETS_ENV
  and runs 'systemctl --user daemon-reload'. Does NOT restart the daemon.

  --no-unit           Only write the env file; leave systemd alone.
  --refresh-on-start  Also add 'ExecStartPre=-' that re-runs inject on every service
                      start (picks up key rotation; failures never block startup).
USAGE
        return 0 ;;
      *) echo "Unknown option: $1 (see: companion install-secrets --help)"; return 2 ;;
    esac
    shift
  done

  if [ ! -x "$CUSH_INJECT" ]; then
    echo "ERROR: cush-tools inject not found at $CUSH_INJECT (set CUSH_INJECT to override)."
    return 1
  fi
  if [ ! -f "$SECRETS_MANIFEST" ]; then
    echo "ERROR: secrets manifest not found: $SECRETS_MANIFEST"
    return 1
  fi

  mkdir -p "$(dirname "$SECRETS_ENV")"
  # --no-prompt: never spawn a secure-entry form from a script context. To add a
  # missing key, use cush-tools secure-entry --save-to-inf, then re-run this.
  if ! "$CUSH_INJECT" --manifest "$SECRETS_MANIFEST" --out "$SECRETS_ENV" --no-prompt; then
    echo "ERROR: inject failed; $SECRETS_ENV was not updated. No values were printed."
    return 1
  fi
  chmod 600 "$SECRETS_ENV"
  echo "Wrote $SECRETS_ENV (mode 600; keys: $(cut -d= -f1 "$SECRETS_ENV" | paste -sd, -))"

  if ! $want_unit; then
    return 0
  fi
  if [[ "$OSTYPE" == darwin* ]]; then
    echo "macOS: launchd does not read env files. bin/companion sources $SECRETS_ENV itself when it"
    echo "launches the daemon; for the launchd agent, add the key to its EnvironmentVariables."
    return 0
  fi

  mkdir -p "$SYSTEMD_DROPIN_DIR"
  local tmp="$SYSTEMD_DROPIN.tmp.$$"
  {
    echo "# Managed by 'bin/companion install-secrets'. Loads daemon secrets (e.g. ANTHROPIC_API_KEY"
    echo "# for Herald) from a chmod-600 file outside the repo. '-' = optional: a missing file"
    echo "# never blocks startup (Herald just reports the brain as unconfigured)."
    echo "[Service]"
    if $refresh_on_start; then
      # systemd's PATH lacks ~/.local/bin (infisical CLI); pin the dirs inject needs.
      local inj_path="/usr/local/bin:/usr/bin:/bin"
      local d
      for d in "$(dirname "$(command -v infisical 2>/dev/null || echo /usr/bin/x)")" "$(dirname "$(command -v python3)")"; do
        case ":$inj_path:" in *":$d:"*) ;; *) inj_path="$d:$inj_path" ;; esac
      done
      echo "ExecStartPre=-/usr/bin/env PATH=$inj_path $CUSH_INJECT --manifest $SECRETS_MANIFEST --out $SECRETS_ENV --no-prompt"
    fi
    echo "EnvironmentFile=-$SECRETS_ENV"
  } > "$tmp"
  if [ -f "$SYSTEMD_DROPIN" ] && cmp -s "$tmp" "$SYSTEMD_DROPIN"; then
    rm -f "$tmp"
    echo "systemd drop-in already up to date: $SYSTEMD_DROPIN"
  else
    mv "$tmp" "$SYSTEMD_DROPIN"
    echo "Wrote systemd drop-in: $SYSTEMD_DROPIN"
    if command -v systemctl &>/dev/null; then
      systemctl --user daemon-reload && echo "Reloaded systemd user units (daemon NOT restarted)."
    fi
  fi
  echo ""
  echo "The running daemon still has its old environment. The key takes effect on the next"
  echo "daemon restart, which needs your explicit sign-off."
}

# --- Config: herald-provider ---
# Idempotently sets herald.provider (and optionally herald.model) in the live
# config, preserving every other key and the file's permissions. Atomic write.
cmd_herald_provider() {
  local provider="" model="" config="${COMPANION_CONFIG:-${CONFIG_PATH:-$CONFIG_DIR/config.json}}"
  while [ $# -gt 0 ]; do
    case "$1" in
      anthropic|openai_compatible) provider="$1" ;;
      --model) model="${2:-}"; shift ;;
      --config) config="${2:-}"; shift ;;
      -h|--help)
        echo "Usage: companion herald-provider <anthropic|openai_compatible> [--model NAME] [--config PATH]"
        echo "  Sets herald.provider (and herald.model if given) in $config."
        echo "  Idempotent; preserves all other settings. Takes effect on the next daemon restart."
        return 0 ;;
      *) echo "Unknown argument: $1 (see: companion herald-provider --help)"; return 2 ;;
    esac
    shift
  done
  if [ -z "$provider" ]; then
    echo "Usage: companion herald-provider <anthropic|openai_compatible> [--model NAME] [--config PATH]"
    return 2
  fi
  if [ ! -f "$config" ]; then
    echo "ERROR: config not found: $config (run 'companion setup' first)"
    return 1
  fi
  CFG="$config" PROVIDER="$provider" MODEL="$model" node -e '
    const fs = require("fs"), path = require("path");
    const file = process.env.CFG;
    const cfg = JSON.parse(fs.readFileSync(file, "utf-8"));
    const had = cfg.herald && typeof cfg.herald === "object" && !Array.isArray(cfg.herald);
    const herald = had ? cfg.herald : {};
    const before = JSON.stringify(herald);
    herald.provider = process.env.PROVIDER;
    if (process.env.MODEL) herald.model = process.env.MODEL;
    const desc = `herald.provider="${herald.provider}"${herald.model ? `, herald.model="${herald.model}"` : ""}`;
    if (had && before === JSON.stringify(herald)) {
      console.log(`Already set: ${desc} in ${file}; no change.`);
      process.exit(0);
    }
    cfg.herald = herald;
    const mode = fs.statSync(file).mode & 0o777;
    const tmp = path.join(path.dirname(file), `.${path.basename(file)}.${process.pid}.tmp`);
    fs.writeFileSync(tmp, JSON.stringify(cfg, null, 2) + "\n", { mode });
    fs.chmodSync(tmp, mode);
    fs.renameSync(tmp, file);
    console.log(`Set ${desc} in ${file}`);
    console.log("Takes effect on the next daemon restart (needs your sign-off).");
  '
}

case "${1:-}" in
  install-secrets) shift; cmd_install_secrets "$@"; exit $? ;;
  herald-provider) shift; cmd_herald_provider "$@"; exit $? ;;
esac

# Every other launch path (foreground, background, CLI-driven restart) loads the
# same secrets file the systemd drop-in uses, so Herald's key reaches the daemon
# however it is launched. Exported only into this process tree.
if [ -f "$SECRETS_ENV" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$SECRETS_ENV"
  set +a
fi

# --- Always ensure daemon is built ---
build_daemon

# --- Setup: also build web client ---
if [ "${1:-}" = "setup" ]; then
  build_web
  exec node "$ENTRY" "$@"
fi

# --- Start command (default) ---
if [ "${1:-}" = "" ] || [ "${1:-}" = "start" ]; then
  # Parse flags
  FOREGROUND=false
  shift 2>/dev/null || true  # consume "start" if present
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--foreground)
        FOREGROUND=true
        shift
        ;;
      *)
        echo "Unknown option: $1"
        echo "Usage: companion start [-f|--foreground]"
        exit 1
        ;;
    esac
  done

  # Also build web client for start (daemon serves it)
  build_web

  # Check if already running
  if [ -f "$PID_FILE" ]; then
    EXISTING_PID=$(cat "$PID_FILE" 2>/dev/null || true)
    if [ -n "$EXISTING_PID" ] && kill -0 "$EXISTING_PID" 2>/dev/null; then
      echo "Daemon is already running (PID $EXISTING_PID)"
      echo "Use 'companion stop' to stop it first, or 'companion restart' to restart."
      exit 1
    fi
    # Stale PID file — clean up
    rm -f "$PID_FILE"
  fi

  if $FOREGROUND; then
    exec node "$ENTRY" start
  fi

  # Background start
  mkdir -p "$(dirname "$LOG_FILE")"
  nohup node "$ENTRY" start >> "$LOG_FILE" 2>&1 &
  DAEMON_PID=$!

  # Write PID file (the node CLI also writes one, but we write early for the liveness check)
  mkdir -p "$CONFIG_DIR"
  echo "$DAEMON_PID" > "$PID_FILE"

  # 1-second liveness check
  sleep 1
  if ! kill -0 "$DAEMON_PID" 2>/dev/null; then
    echo "ERROR: Daemon exited immediately after starting."
    echo ""
    echo "Last 20 lines of log ($LOG_FILE):"
    tail -20 "$LOG_FILE" 2>/dev/null || echo "(no log output)"
    rm -f "$PID_FILE"
    exit 1
  fi

  echo "Daemon started (PID $DAEMON_PID)"
  echo "  Logs: $LOG_FILE"
  exit 0
fi

# --- Restart: rebuild web client too (daemon serves it) ---
if [ "${1:-}" = "restart" ]; then
  build_web
fi

# --- All other commands delegate to node CLI ---
exec node "$ENTRY" "$@"
