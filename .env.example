# Copy to .env and adjust. docker compose reads it automatically.

# Where your code lives on this machine (mounted at ~/projects in the container).
COMPANION_PROJECTS=./projects

# Your user and group ids (run: id -u ; id -g), so files the sessions create
# in your projects belong to you.
PUID=1000
PGID=1000

# Web UI / app port on this machine. 127.0.0.1 keeps it off your network.
COMPANION_PORT=9877
COMPANION_BIND=0.0.0.0

# Server name shown in the apps (first start only; the wizard can change it).
COMPANION_NAME=

TZ=UTC

# Where the setup wizard finds the app installers (Android / desktop). The
# apps update themselves from the public feed. Empty turns the lookup off.
COMPANION_APP_FEED_URL=https://dev.cush.rocks/updates/stable/

# Optional profiles: voice (Herald's local voice service), tailscale.
# COMPOSE_PROFILES=voice,tailscale

# Host networking for Nearby discovery (Linux only), see docs/docker.md.
# COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml

# Tailscale sidecar (profile "tailscale"): an auth key from the admin console.
TS_AUTHKEY=
TS_HOSTNAME=companion

# Pull a different image, or build your own with bin/docker build.
# COMPANION_IMAGE=ghcr.io/hexidecibel/companion:latest
# COMPANION_VOICE_IMAGE=ghcr.io/hexidecibel/companion-voice:latest

# Voice service thread caps (same defaults as a host install).
# HERALD_TTS_THREADS=6
# HERALD_STT_THREADS=4
