<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS signing entitlements, applied with the hardened runtime (Developer ID
     builds; bundle.macOS.hardenedRuntime). The microphone entitlement is required
     for Herald then. Nothing else is needed: WKWebView JIT runs in Apple's own
     WebContent process (no cs.allow-jit), the passthrough CGEventTap needs the
     Input Monitoring TCC permission (not an entitlement), and macOSPrivateApi is
     fine outside the App Store. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
