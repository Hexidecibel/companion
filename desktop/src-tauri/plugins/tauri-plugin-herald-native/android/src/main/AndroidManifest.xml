<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Herald voice: the WebView's getUserMedia (wry's RustWebChromeClient asks
         for these at runtime, then grants RESOURCE_AUDIO_CAPTURE). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Sideload updater: hand a verified APK to the system installer (the user confirms). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
