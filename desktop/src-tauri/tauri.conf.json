{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Companion",
  "version": "1.0.0",
  "identifier": "com.hexidecibel.companion",
  "build": {
    "frontendDist": "../../web/dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../web && npm run build:desktop",
    "beforeDevCommand": "cd ../web && npx vite --base /"
  },
  "app": {
    "windows": [
      {
        "title": "Companion",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "iOS": {
      "minimumSystemVersion": "17.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3NDhGMTcyNzNBMUMwRjEKUldUeHdLRnpjdkZJNTMxM2toT01wWnNTWmVwNjhEbU9LMDFkN21pMU5WL3p4NVJiMitaaUx2dUYK",
      "endpoints": [
        "https://dev.cush.rocks/updates/stable/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
